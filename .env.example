# Phukumhom Resort Khao Yai — environment variables
#
# Copy to .env.local for local work (Next.js reads it; .env* files are git-ignored except this one).
# The full description of each integration, its status today and how to enable it is in
# docs/INTEGRATIONS.md. Nothing in this file is a secret. Real values for the ENQUIRY_WEBHOOK_*
# variables ARE secrets: set them only in the host's environment settings, never in the repository.
#
# With every line below left empty the site is a complete private preview: booking links work,
# no analytics is loaded, no consent banner is shown, enquiries are not delivered anywhere.

# ───────────── Environment ─────────────

# Set to "production" on the ONE public deployment, at build time and at start time.
# Anything else (or empty) is a private preview: robots.txt disallows everything, every page says
# noindex, X-Robots-Tag: noindex is sent, and no HSTS / upgrade-insecure-requests header is added.
SITE_ENV=

# Canonical origin of a preview or staging deployment, no trailing slash (https://staging.example.com).
# Used for canonicals, hreflang, Open Graph URLs and the sitemap. Empty → http://127.0.0.1:8352.
# Ignored when SITE_ENV=production: the public site always uses site.origin.production
# from src/content/site.ts. Inlined at build time.
NEXT_PUBLIC_SITE_ORIGIN=

# ───────────── Analytics (inert) ─────────────

# GA4 measurement id, in the form G-XXXXXXXXXX. On its own this does nothing: the "analytics" flag in
# src/content/site.ts must also be true. With both set, the consent banner appears and Google
# Analytics loads only after a visitor presses Accept. Inlined at build time; next.config.ts adds the
# Google hosts to the Content-Security-Policy only when this is set.
NEXT_PUBLIC_GA4_ID=

# ───────────── Enquiry delivery (not configured) ─────────────

# How an accepted enquiry leaves the server. Empty → nothing is delivered and the contact page offers
# "Copy enquiry" plus the phone and Facebook links instead of "Send". The "enquiryDelivery" flag in
# src/content/site.ts must also be true before a Send button is shown.
ENQUIRY_DELIVERY=

# HTTPS endpoint that receives accepted enquiries as a server-to-server POST. Secret.
ENQUIRY_WEBHOOK_URL=

# Shared secret used to sign each delivery so the receiver can verify it came from this site. Secret.
ENQUIRY_WEBHOOK_SECRET=

# ───────────── QA tools only (never needed by the site) ─────────────

# Base URL for scripts/check-content.mjs and _qa/shot.mjs. Empty → http://127.0.0.1:8352.
# QA_BASE=
